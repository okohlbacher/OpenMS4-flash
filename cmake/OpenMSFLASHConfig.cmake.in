@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(OpenMS @OpenMS_VERSION@ EXACT CONFIG)
if(NOT OpenMS_SOURCE_REVISION STREQUAL "@OpenMS_SOURCE_REVISION@")
  message(FATAL_ERROR "OpenMSFLASH requires OpenMS core commit @OpenMS_SOURCE_REVISION@")
endif()
set(OpenMSFLASH_VERSION "@PROJECT_VERSION@")
set(OpenMSFLASH_SOURCE_REVISION "@OpenMSFLASH_SOURCE_REVISION@")
set(OpenMSFLASH_SOURCE_DIRTY "@OpenMSFLASH_SOURCE_DIRTY@")
if(NOT TARGET OpenMS::FLASH)
  include("${CMAKE_CURRENT_LIST_DIR}/OpenMSFLASHTargets.cmake")
  set_property(TARGET OpenMS::FLASH PROPERTY OPENMSFLASH_SOURCE_REVISION "@OpenMSFLASH_SOURCE_REVISION@")
else()
  get_target_property(_openms_flash_revision OpenMS::FLASH OPENMSFLASH_SOURCE_REVISION)
  if(NOT _openms_flash_revision STREQUAL "@OpenMSFLASH_SOURCE_REVISION@")
    message(FATAL_ERROR "An OpenMS::FLASH target from a different source revision is already loaded")
  endif()
  unset(_openms_flash_revision)
endif()
check_required_components(OpenMSFLASH)
